{
  "manifest_version": 3,
  "name": "Litrão do Reset - Extrator de Contatos WhatsApp Web",
  "version": "1.0.0",
  "description": "Extraia participantes e contatos de grupos do WhatsApp Web e envie diretamente para o CRM Kanban do Litrão do Reset.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Extrator WhatsApp - Litrão do Reset"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
