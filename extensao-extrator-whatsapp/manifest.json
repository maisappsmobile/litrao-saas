{
  "manifest_version": 3,
  "name": "Litrão do Reset - WhatsApp SuperSuite Pro",
  "version": "2.1.0",
  "description": "Extrator de grupos, mensagens rápidas em 1 clique, sequências e integração total com o CRM Kanban do Litrão.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Extrator WhatsApp - Litrão do Reset"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "*://*.litraodoreset.com.br/*",
    "*://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
