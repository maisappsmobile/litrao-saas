{
  "manifest_version": 3,
  "name": "ResetFIT - Automação WhatsApp & Facebook Pro",
  "version": "2.6.0",
  "description": "ResetFIT: Extrator 1-Clique de Contatos do WhatsApp e Facebook Grupos, Sincronização Automática com CRM e Painel.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ResetFIT - Automação WhatsApp & Facebook Pro"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "sidePanel",
    "unlimitedStorage"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*.facebook.com/*",
    "*://*.litraodoreset.com.br/*",
    "*://*.vercel.app/*",
    "*://localhost/*",
    "*://127.0.0.1/*",
    "file:///*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "facebook-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.litraodoreset.com.br/*",
        "*://*.vercel.app/*",
        "*://localhost/*",
        "*://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "painel-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "painel-bridge.js",
        "facebook-content.js",
        "icons/*"
      ],
      "matches": [
        "https://web.whatsapp.com/*",
        "https://*.facebook.com/*",
        "*://*.litraodoreset.com.br/*",
        "*://*.vercel.app/*",
        "*://localhost/*",
        "*://127.0.0.1/*",
        "file:///*"
      ]
    }
  ]
}
